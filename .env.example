# ==============================================================================
# Wall Street Interiors - Production Environment Variables Template
# ==============================================================================
# Instructions:
# 1. Copy this file to `.env.local` (for development) or `.env` (for production server)
#    Command: cp .env.example .env
# 2. Replace all placeholder values with your real database & domain credentials.
# ==============================================================================

# Node Environment ('production' for hosting, 'development' for local)
NODE_ENV=production

# Application URL (Canonical domain with https://, no trailing slash)
# Used for SEO sitemaps, robots.txt, session verification, and redirects
AUTH_URL=https://yourdomain.com

# Site Branding
NEXT_PUBLIC_SITE_NAME="Wall Street Interiors"

# Cryptographic Domain Session JWT Secrets (Strictly Isolated)
# Generate strong 64-char keys using: openssl rand -hex 32
CUSTOMER_JWT_SECRET=replace_with_customer_jwt_secret_hex_64_characters_min
ADMIN_JWT_SECRET=replace_with_admin_jwt_secret_hex_64_characters_min
DEALER_JWT_SECRET=replace_with_dealer_jwt_secret_hex_64_characters_min

# Legacy Fallback Secret
AUTH_SECRET=replace_with_a_super_secure_random_64_character_hex_secret_key_here

# MySQL / MariaDB Database Connection
# On cPanel or Ubuntu VPS, DB_HOST is usually '127.0.0.1' or 'localhost'
DB_HOST=127.0.0.1

# MySQL Port (Standard Linux/cPanel port is 3306; local XAMPP may use 3306 or 3308)
DB_PORT=3306

# Database Name (e.g. ecommerce or cpaneluser_ecommerce)
DB_NAME=ecommerce

# Database User
DB_USER=ecommerce_user

# Database Password
DB_PASSWORD=your_strong_database_password_here

